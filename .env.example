DB_PASSWORD=cambia-esto
DB_HOST=db
DB_PORT=3306
MARIADB_ROOT_PASSWORD=cambia-esto-tambien

# Despliegue: nombre DNS del servidor (para Caddy y HTTPS)
DOMINIO=localhost
