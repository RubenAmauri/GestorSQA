# Copia este archivo como .env y llena los valores. El .env nunca se sube al repositorio.
# Para generar claves: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
# En el servidor: el nombre DNS y localhost (lo usa el healthcheck del contenedor).
DJANGO_ALLOWED_HOSTS=gestorsqa.westus2.cloudapp.azure.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://gestorsqa.westus2.cloudapp.azure.com
GUNICORN_WORKERS=2

# Base de datos (MariaDB)
DB_ENGINE=mysql
DB_NAME=gestorsqa
DB_USER=gestorsqa
DB_PASSWORD=cambia-esto
DB_HOST=db
DB_PORT=3306
MARIADB_ROOT_PASSWORD=cambia-esto-tambien

# Despliegue: nombre DNS del servidor (Caddy obtiene el certificado HTTPS para él)
DOMINIO=gestorsqa.westus2.cloudapp.azure.com
